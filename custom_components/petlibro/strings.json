        "device_id": {
          "name": "Device",
          "description": "The litter box to change."
        },
        "plan_id": {
          "name": "Schedule ID",
          "description": "The planId of the schedule to remove. IDs are listed in the attributes of the \"Cleaning schedules\" sensor."
        }
      }
    },
    "edit_feeding_plan": {
      "name": "Edit Feeding Plan",
      "description": "Edit an existing scheduled feeding plan on a dry food feeder. Only the fields you provide will be changed — anything left blank keeps its current value. Find the Plan ID in the feeder's Feeding Schedule sensor attributes.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The feeder to target."
        },
        "plan_id": {
          "name": "Plan ID",
          "description": "The ID of the plan to edit. Find this in the feeder's Feeding Schedule sensor attributes (planID field)."
        },
        "time": {
          "name": "Time",
          "description": "New feed time (e.g. 08:00)."
        },
        "portions": {
          "name": "Portions",
          "description": "Number of portions to dispense (1–48)."
        },
        "label": {
          "name": "Label",
          "description": "A name for this feeding plan. No spaces allowed (e.g. MorningFeed)."
        },
        "days": {
          "name": "Repeat Days",
          "description": "Days of the week to repeat. Leave empty to keep existing days."
        },
        "sound": {
          "name": "Meal Call Sound",
          "description": "Play the meal call sound when dispensing."
        }
      }
    },
    "share_device": {
      "name": "Share a device",
